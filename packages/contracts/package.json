{
  "name": "@auto-tm/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "@asteasolutions/zod-to-openapi": "^7.3.0"
  },
  "devDependencies": {
    "@auto-tm/tsconfig": "workspace:*",
    "@auto-tm/eslint-config": "workspace:*",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "typescript": "^5.7.3",
    "eslint": "^9.18.0"
  }
}
