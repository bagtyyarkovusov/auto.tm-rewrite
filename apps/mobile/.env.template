# apps/mobile — environment template (Expo)
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.
# Never put real secrets here — they go on the server.

# ─── API connection ─────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:3000/ws/chat
EXPO_PUBLIC_MEDIA_URL=http://localhost:9000

# ─── Push transport ─────────────────────────────────────────────────────
EXPO_PUBLIC_PUSH_TRANSPORT=fcm                # fcm | ntfy

# ─── App identity ───────────────────────────────────────────────────────
EXPO_PUBLIC_APP_VERSION=0.1.0
EXPO_PUBLIC_ENV=development                   # development | staging | production

# ─── Deep linking ───────────────────────────────────────────────────────
EXPO_PUBLIC_UNIVERSAL_LINK_DOMAIN=auto.tm
EXPO_PUBLIC_CUSTOM_SCHEME=autotm

# ─── Feature flags (override at build time per environment) ─────────────
EXPO_PUBLIC_FEATURE_360_PHOTOS=false          # Phase 3
EXPO_PUBLIC_FEATURE_INSPECTION_REPORTS=false  # Phase 2
EXPO_PUBLIC_FEATURE_COMPARISONS=false         # Phase 3
