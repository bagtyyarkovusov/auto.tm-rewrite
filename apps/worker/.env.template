# apps/worker — environment template
# Worker shares most env vars with apps/api (it accesses the same DB + Redis + MinIO + push transports).
# Keep this file in sync with apps/api/.env.template when adding/removing vars used by the worker.

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Database (Prisma) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://auto_tm:auto_tm_pass@localhost:5432/auto_tm_dev

# ─── Cache + queue ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (MinIO) ─────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# ─── Push notifications (same as apps/api) ──────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tm.auto.app
APNS_PRIVATE_KEY=

PUSH_TRANSPORT=test                           # fcm-apns | ntfy | test

# ─── Worker tuning ──────────────────────────────────────────────────────
WORKER_CONCURRENCY_VIDEO_TRANSCODE=1          # ffmpeg is CPU-hungry; 1 per CPU core typical
WORKER_CONCURRENCY_IMAGE_VARIANTS=4
WORKER_CONCURRENCY_PUSH=10
WORKER_CONCURRENCY_NOTIFICATION_FANOUT=2

# ─── ffmpeg ─────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg                            # Override if custom build needed
FFMPEG_THREADS=auto                           # Or specific count

# ─── Orphan cleanup ─────────────────────────────────────────────────────
ORPHAN_CLEANUP_MIN_AGE_HOURS=24
ORPHAN_CLEANUP_CRON=0 3 * * *                 # 03:00 daily (TM time)
