{
  "name": "@auto-tm/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:deps": "test -f ../../packages/db/dist/src/index.js && test -f ../../packages/contracts/dist/index.js || (pnpm --filter @auto-tm/db build && pnpm --filter @auto-tm/contracts build)",
    "prebuild": "pnpm run build:deps",
    "build": "nest build",
    "predev": "pnpm run build:deps",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint . --max-warnings 0",
    "pretest": "pnpm run build:deps",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auto-tm/contracts": "workspace:*",
    "@auto-tm/db": "workspace:*",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.16",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@auto-tm/eslint-config": "workspace:*",
    "@auto-tm/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
