# apps/web — environment template

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002

# Runtime public web origin for legal canonical links. Matches the mobile
# EXPO_PUBLIC_WEB_URL setting for this deployment; no rebuild is needed.
# Staging: https://staging.autotm.bagtyyar.dev
# Reviewer production: https://autotm.bagtyyar.dev
# If unset, uses RAILWAY_PUBLIC_DOMAIN, then localhost for local development.
WEB_BASE_URL=http://localhost:3002

# Deploy evidence for /healthz (dependency-free deploy health route).
# AUTOTM_COMMIT_SHA is baked into the image at build time from
# RAILWAY_GIT_COMMIT_SHA (infra/docker/web.Dockerfile); Railway also
# injects RAILWAY_ENVIRONMENT_NAME at runtime. No local setup needed.

# ─── API connection ─────────────────────────────────────────────────────
# Server-side API base for Server Functions (account deletion). Falls back to
# NEXT_PUBLIC_API_URL. On Railway, set it to the API's private
# *.railway.internal origin. The origin alone or origin + /api/v1 both work.
API_BASE_URL=http://localhost:3006/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3006/api/v1
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000

# Visitor IP for the API's per-IP Sign-in Code budget (ADR-0078). Web reads the
# address from CLIENT_IP_HEADER, which the ingress in front of web must set or
# overwrite (Railway's edge sets x-real-ip), and forwards it to the API in
# API_CLIENT_IP_HEADER, the header the API trusts on web's private path. For a
# proxy that appends to x-forwarded-for, set CLIENT_IP_HEADER=x-forwarded-for
# and CLIENT_IP_TRUSTED_HOPS to the number of proxies you run; that is safe
# only when web cannot be reached except through them. `none` forwards no
# address. Locally no header is set, so the API counts web's own address.
CLIENT_IP_HEADER=x-real-ip
CLIENT_IP_TRUSTED_HOPS=1
API_CLIENT_IP_HEADER=x-real-ip

# ─── App store badges ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_STORE_URL=                    # Apple App Store URL (post-launch)
NEXT_PUBLIC_PLAY_STORE_URL=                   # Google Play Store URL (post-launch)

# ─── OG image generation ────────────────────────────────────────────────
NEXT_PUBLIC_OG_IMAGE_BASE_URL=http://localhost:3002/api/og

# ─── Analytics (Phase 2+, must be self-hosted, never Google Analytics) ──
# ANALYTICS_ENDPOINT=
