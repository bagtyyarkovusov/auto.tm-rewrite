# apps/sms-gateway — environment template

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3090
METRICS_PORT=3091                             # Prometheus scrape endpoint
LOG_LEVEL=info

# ─── Auth (gateway ↔ API) ───────────────────────────────────────────────
API_INBOUND_TOKEN=replace_me_with_random_token   # The token apps/api must present

# ─── Auth (agent ↔ gateway WebSocket) ───────────────────────────────────
AGENT_AUTH_TOKEN=replace_me_with_random_token    # The token each phone-agent presents

# ─── Storage ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://auto_tm:auto_tm_pass@localhost:5432/auto_tm_sms_dev

# ─── Phone fleet config ─────────────────────────────────────────────────
PHONE_DAILY_SMS_CAP=80                           # Per-SIM daily limit
PHONE_INTER_MESSAGE_DELAY_MIN_MS=5000            # Randomize 5-30s between sends per phone
PHONE_INTER_MESSAGE_DELAY_MAX_MS=30000
PHONE_HEARTBEAT_TIMEOUT_MS=90000                 # Mark phone down after 90s without heartbeat

# ─── Observability ──────────────────────────────────────────────────────
PROMETHEUS_PUSHGATEWAY_URL=                      # Optional — push metrics if scrape unreachable
