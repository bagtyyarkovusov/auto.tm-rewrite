# apps/sms-gateway — environment template
# Copy to .env (gitignored) for local development.
# Production .env lives on TM Server B and is managed manually.

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3090
LOG_LEVEL=info                                # fatal | error | warn | info | debug | trace

# ─── Auth ───────────────────────────────────────────────────────────────
GATEWAY_TOKEN=change-me-min-8-chars

# ─── OTP driver ─────────────────────────────────────────────────────────
OTP_DRIVER=mock                               # mock | fleet
