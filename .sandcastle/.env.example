# Required for a sandcastle run — sandcastle forwards these into each sandbox.
# Copy this file to .sandcastle/.env (gitignored) and fill in. NEVER commit .env.

# Kimi Code API key. Used as the backend for Claude Code (see ANTHROPIC_* below).
KIMI_API_KEY=

# GitHub token with repo scope (issue read/close, push). The planner, implementer,
# and merger all shell out to `gh`.
GH_TOKEN=

# Context7 MCP key for live library docs inside the sandbox (ADR-0017). Recommended.
CONTEXT7_API_KEY=

# Claude Code → Kimi: the planner/implementer/reviewer/merger run the `claude` CLI
# against Kimi's Anthropic-compatible endpoint (https://api.kimi.com/coding/). Set
# ANTHROPIC_API_KEY to the SAME value as KIMI_API_KEY above.
ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
ANTHROPIC_API_KEY=

# The implementer/merger setup hook runs `pnpm --filter @auto-tm/db generate`.
# packages/db/prisma.config.ts resolves env("DATABASE_URL") at config-load time
# (it throws if unset), even though `generate` never connects to a database. A
# clean sandbox worktree has no packages/db/.env, so declare a dummy here — any
# syntactically-valid URL works. Only keys listed in this file are forwarded into
# the sandbox (EnvResolver), so it MUST be declared even if just a placeholder.
DATABASE_URL=postgresql://user:pass@localhost:5432/autotm?schema=public

# Optional host-side safety knobs.
# Sandcastle checks these before each planner cycle so it does not create
# half-configured worktrees when the shared GitHub quota is exhausted.
SANDCASTLE_MIN_GH_CORE_REMAINING=50
SANDCASTLE_MIN_GH_GRAPHQL_REMAINING=50

# Optional agent idle budgets. If Kimi/Claude Code produces no output for this
# many seconds, Sandcastle stops the phase and preserves the worktree for review.
SANDCASTLE_IMPLEMENTER_IDLE_TIMEOUT_SECONDS=300
SANDCASTLE_REVIEWER_IDLE_TIMEOUT_SECONDS=180
SANDCASTLE_MERGER_IDLE_TIMEOUT_SECONDS=180
